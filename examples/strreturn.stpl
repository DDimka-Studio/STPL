!export display*
!export logic*
!export str*
!export exit*

start main

digit_name(float d) {
    if d == 0 { return "zero" };
    if d == 1 { return "one" };
    if d == 2 { return "two" };
    return "unknown"
};

main() {
    int(char=16) a = ""
    int(char=16) b = ""
    int(char=16) c = ""
    digit_name(0) > a
    digit_name(1) > b
    digit_name(9) > c
    display.show.text(a)
    display.show.text(b)
    display.show.text(c)

    exit display
    exit logic
    exit str
    exit a
    exit b
    exit c
    exit exit
    return 0
};
